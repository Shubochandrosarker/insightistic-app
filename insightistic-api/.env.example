APP_NAME=Insightistic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

INSIGHTISTIC_APP_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Every documented production path (docker-compose.prod.yml,
# docker-compose.hostinger.yml, docker-compose.hostinger-url.yml) forces
# DB_CONNECTION=pgsql. A fresh `composer create-project laravel/laravel`
# defaults to sqlite instead — pin Postgres here too so local dev never
# silently drifts onto a different database driver/schema behavior than
# production.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=insightistic
DB_USERNAME=insightistic
DB_PASSWORD=

# Safe WooCommerce Query Engine (P1) read-only execution identity. Leave
# unset for local dev (the engine falls back to DB_USERNAME above with a
# warning); REQUIRED in production — the engine refuses to run without it.
# Provision the role once: php artisan db:provision-readonly-role
# See docs/SAFE-QUERY-ENGINE.md.
READONLY_DB_USERNAME=
READONLY_DB_PASSWORD=

SESSION_DRIVER=database
# Redis for cache/queues/rate-limiting in production (docker compose ships a
# redis service). "database" also works for tiny installs.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# API tokens expire after this many minutes (security hardening; 0 disables).
SANCTUM_EXPIRATION_MINUTES=720

# Proxy mode (see docs/INSTALL.md §2): the Next.js app forwards /api/* to
# this host server-side, so CORS/session-domain settings below are inert
# for that path — only needed if you run the frontend in "direct mode".
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# OAuth is optional. Leave blank to hide the social login buttons.
OAUTH_REDIRECT_BASE=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Dashboard AI uses a server-selected plan-aware provider chain.
INSIGHTISTIC_AI_PROVIDER=plan_aware
INSIGHTISTIC_AI_MODEL=gpt-4o-mini
INSIGHTISTIC_AI_TIMEOUT=240
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=180
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_FREE_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_PAID_MODEL=openai/gpt-6-luna
OPENROUTER_PAID_FALLBACK_MODELS=z-ai/glm-5.3-flash,z-ai/glm-5.3-prime
WPISTIC_GATEWAY_URL=https://ai.wpistic.com
WPISTIC_GATEWAY_PRODUCT_KEY=
WPISTIC_GATEWAY_PRODUCT_ID=insightistic
WPISTIC_GATEWAY_MODEL=glm-5.3
WPISTIC_GATEWAY_MAX_TOKENS=1200
WPISTIC_GATEWAY_TIMEOUT=30

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=reports@insightistic.com
MAIL_FROM_NAME=Insightistic

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

INSIGHTISTIC_REPORTS_DISK=public
INSIGHTISTIC_TRIAL_DAYS=14
INSIGHTISTIC_LICENSE_VALIDATE_INTERVAL=86400
INSIGHTISTIC_LICENSE_GRACE_HOURS=72
INSIGHTISTIC_PAYMENT_GRACE_DAYS=7

# ---- AI Knowledge Base (Phase 4) -------------------------------------
# Embeddings: "none" = full-text-search-only retrieval (no external calls);
# "openai" = any OpenAI-compatible /embeddings endpoint.
INSIGHTISTIC_EMBEDDINGS_PROVIDER=none
INSIGHTISTIC_EMBEDDINGS_MODEL=text-embedding-3-small
INSIGHTISTIC_EMBEDDINGS_DIMENSION=1536
INSIGHTISTIC_EMBEDDINGS_API_KEY=
INSIGHTISTIC_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
INSIGHTISTIC_EMBEDDINGS_TIMEOUT=30

# Knowledge uploads: disk ("local" for dev, an S3 disk name in production —
# see config/filesystems.php), size and crawl caps.
INSIGHTISTIC_KNOWLEDGE_DISK=local
INSIGHTISTIC_KNOWLEDGE_MAX_FILE_MB=20
INSIGHTISTIC_KNOWLEDGE_MAX_CONTENT_BYTES=2000000
INSIGHTISTIC_KNOWLEDGE_CRAWL_TIMEOUT=20
INSIGHTISTIC_KNOWLEDGE_CRAWL_MAX_BYTES=10485760

# Optional S3-compatible object storage (reports + knowledge files).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# NOTE: SUPER_ADMIN_EMAIL was removed (security fix). Create the first super
# admin with: php artisan insightistic:make-super-admin owner@example.com

# ---- Direct data-source integrations (GA4, Search Console, Cloudflare) ----
# Reuses the Google OAuth client above, but with its own redirect URI and
# read-only analytics scopes, so consent for "sign in with Google" never
# silently grants analytics access. Register this exact URI in the Google
# Cloud console alongside the login one. Refresh tokens are exchanged and
# stored server-side only; they never reach the browser.
INTEGRATIONS_GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Seconds before a provider HTTP call is abandoned.
INTEGRATIONS_HTTP_TIMEOUT=20
# Hours before a source's newest data is labelled stale in the dashboard.
INTEGRATIONS_STALE_AFTER_HOURS=48
# Cloudflare needs no server credential: each site stores its own scoped
# API token (Zone -> Analytics -> Read), entered on /dashboard/integrations.
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4

# ---- Email analytics (Mailchimp, Klaviyo, and plugin-side platforms) ------
# No server-level credential: Mailchimp/Klaviyo API keys are entered per site
# on /dashboard/emails and stored encrypted. FluentCRM, AutomateWoo and
# WooCommerce mail are pushed by the plugin over the HMAC connector contract.
EMAIL_ANALYTICS_TIMEOUT=20
EMAIL_ANALYTICS_CAMPAIGN_LIMIT=50

# ---- Privacy and compliance (spec Phase 10) ------------------------------
# Organization deletion is two-stage: a request schedules the purge this many
# days out and can be cancelled until then.
PRIVACY_DELETION_GRACE_DAYS=7
# Disk for generated data-export archives, and how long they stay
# downloadable before the nightly maintenance command deletes them.
PRIVACY_EXPORT_DISK=local
PRIVACY_EXPORT_TTL_DAYS=7

# ---- PageSpeed Insights, run from the SaaS backend (spec Phase 3.3) ------
# Optional: Google allows keyless requests at a much lower quota. Both caps
# exist because a nightly sweep across every site would otherwise exhaust
# the allowance in minutes.
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT=90
PAGESPEED_MAX_PER_MINUTE=20
PAGESPEED_MAX_PER_SITE_PER_DAY=8

# ---- Consent-gated ad conversion delivery (optional) ----------------------
# Delivery is disabled unless the organization has opted into marketing and
# the captured checkout journey contains a gclid or fbclid attribution value.
GOOGLE_ADS_CONVERSIONS_ENABLED=false
GOOGLE_ADS_CONVERSIONS_ENDPOINT=https://googleads.googleapis.com
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_CONVERSIONS_ENABLED=false
META_CONVERSIONS_ENDPOINT=https://graph.facebook.com/v20.0
META_PIXEL_ID=
META_CONVERSIONS_ACCESS_TOKEN=

# ---- Observability (spec Phase 2.3) --------------------------------------
# All off by default: a fresh install sends nothing to any third party until
# a DSN or collector endpoint is deliberately set here.
#
# Error payloads are scrubbed (EventScrubber) before they leave the process —
# request bodies and cookies dropped, secret/PII key names redacted, query
# values stripped from URLs. An exception carries the request that caused it,
# and here that can be a refresh token, a license key or a customer record.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_TRACE_QUEUE_ENABLED=false

# OTLP over HTTP/protobuf — every collector accepts it (Tempo, Honeycomb,
# Jaeger, Datadog, Sentry). Needs BOTH enabled=true and an endpoint; an
# exporter with nowhere to send is just latency.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=insightistic-api
OTEL_SAMPLE_RATE=0.05
OTEL_EXPORTER_TIMEOUT=5

# Hourly request/AI buckets in Postgres, read by the admin dashboard. Cheap
# enough to leave on; pruned nightly at 03:50 so observability data cannot
# become the performance problem it was installed to detect.
OTEL_REQUEST_METRICS=true
OTEL_RETENTION_DAYS=30

# ---- Billing (Paddle foundation) ------------------------------------------
# Active billing provider for NEW checkouts. Existing Stripe subscriptions
# keep working regardless of BILLING_PROVIDER — flipping it to "paddle" only
# changes where new checkouts are created. Paddle sandbox/production is
# switched with PADDLE_ENV (sandbox|production); API key and webhook secret
# are server-side only and must never be exposed through NEXT_PUBLIC_* vars.
BILLING_PROVIDER=stripe
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Master switch for Paddle surfaces; keep "false" until sandbox credentials
# are configured and the webhook endpoint is verified.
FEATURE_PADDLE=false

# ---- Rank tracking (DataForSEO SERP provider, Phase 10) -------------------
# HTTP Basic credentials for api.dataforseo.com. Leave blank to disable rank
# tracking entirely: the scheduled rank check logs a warning and exits, no
# provider call is made and nothing is billed.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
